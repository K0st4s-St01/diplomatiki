<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-artemis</artifactId>
</dependency>

<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-artemis-test</artifactId>
    <scope>test</scope>
</dependency>

    <dependency>
        <groupId>org.apache.activemq</groupId>
